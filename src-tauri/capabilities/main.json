{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Exactly the commands the main window calls, plus listening for the usage event. The frontend never unlistens, so unlisten is not granted. Nothing else.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:event:allow-listen",
    "allow-list-providers",
    "allow-save-key",
    "allow-forget-key",
    "allow-key-hint",
    "allow-refresh",
    "allow-get-settings",
    "allow-update-settings",
    "allow-wipe-now"
  ]
}
