    "type": "git",
    "url": "git+https://github.com/AlveeeRahman/mr-usage.git"
  },
  "keywords": [
    "api-usage",
    "usage-monitor",
    "api-credits",
    "firecrawl",
    "serpapi",
    "elicit",
    "context7",
    "tavily",
    "openrouter",
    "apify",
    "tauri",
    "desktop-app",
    "keychain"
  ],
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
