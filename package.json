  "homepage": "https://alveeerahman.github.io/mr-usage/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlveeeRahman/mr-usage.git"
  },
  "keywords": [
    "api-usage",
    "usage-monitor",
    "api-credits",
    "firecrawl",
    "serpapi",
    "elicit",
    "context7",
    "tavily",
    "openrouter",
    "apify",
    "tauri",
    "desktop-app",
    "keychain"
  ],
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc -p frontend --noEmit && vite build --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
